<?xml version="1.0" encoding="utf-8"?>
<!-- 自定义退出动画：统一不同品牌默认关闭动画的时长差异（300ms 淡出）。
     duration 必须与 MainActivity.EXIT_ANIM_BASE_MS 保持一致，
     杀进程延迟 = duration × 系统动画缩放系数，保证「动画播完立即杀」。 -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="300"
    android:fromAlpha="1.0"
    android:toAlpha="0.0" />
